# Task 1 — Lead Follow-up Automation
# Copy to .env.local (never commit real secrets)

# NVIDIA NIM (email drafts) — live-tested model below
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Legacy Gemini (abandoned after 404/quota — see docs/AI_PROVIDER_FAILURES.md)
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Supabase (Task 1 persistence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Zoho CRM draft-only (native __email_drafts — never sendMail)
# One-time Self Client auth → refresh token. Pipeline refreshes access tokens automatically.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional warm cache (auto-refreshed; do not commit real values)
ZOHO_ACCESS_TOKEN=
ZOHO_ACCESS_TOKEN_EXPIRES_AT=
# Overridden by token response api_domain when refreshing (India often zohoapis.in)
ZOHO_API_DOMAIN=https://www.zohoapis.in
# Must be a configured CRM outgoing address (settings/emails/actions/from_addresses).
# If unset, the adapter lists from_addresses and picks primary/org_email.
ZOHO_FROM_EMAIL=
# Safety: must remain "draft". Pipeline refuses any other value.
ZOHO_SEND_MODE=draft

# Runtime
LEADS_CSV_PATH=../leads.csv
# dry_run | live (live still never auto-sends email)
PIPELINE_MODE=dry_run

# Make.com Task2→1 bridge (local reference only)
# MAKE_WEBHOOK_URL is the Hook Grader → Make ingress (Make Custom Webhook).
# N8N_PUBLIC_BASE_URL is the public tunnel base Make must call for local n8n.
# Changing N8N_PUBLIC_BASE_URL does NOT update Make.com — edit scenario 7960198
# module "Forward to n8n Task1 ingest" URL to:
#   ${N8N_PUBLIC_BASE_URL}${N8N_WEBHOOK_PATH}
MAKE_SCENARIO_ID=7960198
N8N_PUBLIC_BASE_URL=https://your-tunnel-host.trycloudflare.com
N8N_WEBHOOK_PATH=/webhook/myntmore-hook-grader
