# Supabase (URL + anon/publishable may be public; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NVIDIA NIM (server-only — never NEXT_PUBLIC_*)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Make.com Webhook (Task 2 → Task 1 bridge)
# Exact URL from Make.com; do not append paths
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_SECRET=your-optional-hmac-secret

# Vercel Cron authentication
WEBHOOK_CRON_SECRET=your-cron-secret

# Application
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
